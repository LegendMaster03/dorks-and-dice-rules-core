    {
      "id": "condition.entangled",
      "name": "Entangled",
      "kind": "condition",
      "description": "An Entangled creature is restrained by bonds or another ensnaring effect. Unless securely anchored, it moves at half Speed and cannot Run or Charge. It has a -2 attack penalty and a -4 penalty to effective Dexterity; anchored bonds prevent movement entirely. Spellcasting interference is preserved for later integration with the native spellcasting procedure.",
      "effects": [
        {
          "type": "speed",
          "operation": "multiply",
          "factor": 0.5,
          "when": {
            "anchored": false
          }
        },
        {
          "type": "speed",
          "operation": "set",
          "value": 0,
          "canIncrease": false,
          "when": {
            "anchored": true
          }
        },
        {
          "type": "movement-restriction",
          "prohibited": [
            "run",
            "charge"
          ]
        },
        {
          "type": "roll-modifier",
          "appliesTo": "attack-roll",
          "operation": "add",
          "value": -2
        },
        {
          "type": "effective-ability-score",
          "ability": "dexterity",
          "operation": "add",
          "value": -4,
          "minimum": 0,
          "affectsDerivedStatistics": true
        },
        {
          "type": "spellcasting-disruption",
          "requiresCheck": "concentration",
          "dc": {
            "base": 15,
            "perSpellLevel": 1
          },
          "onFailure": "spell-is-lost",
          "integrationStatus": "awaiting-native-spellcasting-reconciliation"
        }
      ]
    },
