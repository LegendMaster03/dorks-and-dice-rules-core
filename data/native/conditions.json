{
  "_meta": {
    "status": "approved-native-mechanics; execution-schema-not-yet-final",
    "note": "Sixteen canonical Dorks & Dice conditions, including the approved Wet house rule. SRD 5.1 Exhaustion and the previously approved Grappled effects remain unchanged. Stunned has half Speed; Petrified does not inherently remove awareness. Original 5.x source records and reconciliation evidence remain under data/reference/srd/."
  },
  "conditions": [
    {
      "id": "condition.blinded",
      "name": "Blinded",
      "kind": "condition",
      "description": "A Blinded creature can not see.",
      "effects": [
        {
          "type": "sense",
          "sense": "sight",
          "availability": "none"
        },
        {
          "type": "check",
          "appliesTo": "ability-check",
          "requiresSense": "sight",
          "result": "automatic-failure"
        },
        {
          "type": "roll-mode",
          "appliesTo": "attack-roll",
          "mode": "advantage",
          "subject": "attacks-against-affected-creature"
        },
        {
          "type": "roll-mode",
          "appliesTo": "attack-roll",
          "mode": "disadvantage",
          "subject": "attacks-by-affected-creature"
        }
      ]
    },
    {
      "id": "condition.charmed",
      "name": "Charmed",
      "kind": "condition",
      "description": "A Charmed creature is unable to attack or deliberately target its charmer with harmful abilities or magical effects.",
      "effects": [
        {
          "type": "targeting-restriction",
          "subject": "affected-creature",
          "protectedTarget": "charmer",
          "prohibited": [
            "attack",
            "harmful-ability",
            "harmful-magical-effect"
          ]
        },
        {
          "type": "roll-mode",
          "appliesTo": "ability-check",
          "mode": "advantage",
          "subject": "charmer",
          "when": {
            "purpose": "social-interaction-with-affected-creature"
          }
        }
      ]
    },
    {
      "id": "condition.deafened",
      "name": "Deafened",
      "kind": "condition",
      "effects": [
        {
          "type": "sense",
          "sense": "hearing",
          "availability": "none"
        },
        {
          "type": "check",
          "appliesTo": "ability-check",
          "requiresSense": "hearing",
          "result": "automatic-failure"
        }
      ]
    },
    {
      "id": "condition.exhaustion",
      "name": "Exhaustion",
      "kind": "leveled-condition",
      "description": "Exhaustion measures cumulative weariness from environmental hazards, deprivation, special abilities, or other effects.",
      "levelRules": {
        "minimum": 0,
        "maximum": 6,
        "gain": "Increase the creature's exhaustion level by the number specified by the effect causing exhaustion.",
        "stacking": "A creature suffers the effects of its current exhaustion level and every lower level.",
        "endsAtLevel": 0
      },
      "levels": [
        {
          "level": 1,
          "effects": [
            {
              "type": "roll-mode",
              "appliesTo": "ability-check",
              "mode": "disadvantage"
            }
          ]
        },
        {
          "level": 2,
          "effects": [
            {
              "type": "speed",
              "operation": "multiply",
              "factor": 0.5
            }
          ]
        },
        {
          "level": 3,
          "effects": [
            {
              "type": "roll-mode",
              "appliesTo": "attack-roll",
              "mode": "disadvantage"
            },
            {
              "type": "roll-mode",
              "appliesTo": "saving-throw",
              "mode": "disadvantage"
            }
          ]
        },
        {
          "level": 4,
          "effects": [
            {
              "type": "maximum-hit-points",
              "operation": "multiply",
              "factor": 0.5
            }
          ]
        },
        {
          "level": 5,
          "effects": [
            {
              "type": "speed",
              "operation": "set",
              "value": 0
            }
          ]
        },
        {
          "level": 6,
          "effects": [
            {
              "type": "death"
            }
          ]
        }
      ],
      "recovery": {
        "general": "An effect that removes exhaustion reduces the level by the amount specified by that effect.",
        "longRest": {
          "levelsRemoved": 1,
          "requirements": [
            "food-consumed",
            "drink-consumed"
          ]
        },
        "raisedFromDead": {
          "levelsRemoved": 1
        }
      }
    },
    {
      "id": "condition.frightened",
      "name": "Frightened",
      "kind": "condition",
      "effects": [
        {
          "type": "roll-mode",
          "appliesTo": "ability-check",
          "mode": "disadvantage",
          "when": {
            "fearSourceWithinLineOfSight": true
          }
        },
        {
          "type": "roll-mode",
          "appliesTo": "attack-roll",
          "mode": "disadvantage",
          "when": {
            "fearSourceWithinLineOfSight": true
          }
        },
        {
          "type": "movement-restriction",
          "restriction": "cannot-willingly-move-closer",
          "relativeTo": "fear-source"
        }
      ]
    },
    {
      "id": "condition.grappled",
      "name": "Grappled",
      "kind": "condition",
      "effects": [
        {
          "type": "speed",
          "operation": "set",
          "value": 0,
          "canIncrease": false
        },
        {
          "type": "roll-mode",
          "appliesTo": "attack-roll",
          "mode": "disadvantage",
          "subject": "attacks-by-affected-creature",
          "when": {
            "targetRelationToGrappler": "other-than-grappler"
          }
        }
      ],
      "endsWhen": [
        {
          "event": "grappler-becomes-incapacitated"
        },
        {
          "event": "grappled-creature-moves-outside-grapple-reach",
          "cause": "any-effect"
        }
      ]
    },
    {
      "id": "condition.incapacitated",
      "name": "Incapacitated",
      "kind": "condition",
      "description": "An Incapacitated creature can not take actions, Bonus Actions, or Reactions. The condition does not itself restrict movement, speech, or awareness.",
      "effects": [
        {
          "type": "action-restriction",
          "cannotTake": [
            "action",
            "bonus-action",
            "reaction"
          ]
        },
        {
          "type": "concentration",
          "operation": "end"
        }
      ]
    },
    {
      "id": "condition.invisible",
      "name": "Invisible",
      "kind": "condition",
      "description": "An Invisible creature can not be seen without magic or a special sense. Its location can still be detected by sound or tracks. The condition does not inherently make the creature hidden.",
      "effects": [
        {
          "type": "visibility",
          "availability": "invisible-to-ordinary-sight",
          "canBeSeenWith": [
            "magic",
            "special-sense"
          ],
          "includesWornOrCarriedEquipment": true
        },
        {
          "type": "obscuration",
          "degree": "heavily-obscured",
          "purpose": "hiding"
        },
        {
          "type": "location-clue",
          "detectableBy": [
            "sound",
            "tracks"
          ]
        },
        {
          "type": "targeting-protection",
          "appliesTo": "effects-requiring-target-to-be-seen",
          "unless": {
            "effectCreatorCanSeeAffectedCreature": true
          }
        },
        {
          "type": "roll-mode",
          "appliesTo": "attack-roll",
          "mode": "advantage",
          "subject": "attacks-by-affected-creature",
          "when": {
            "targetCanSeeAffectedCreature": false
          }
        },
        {
          "type": "roll-mode",
          "appliesTo": "attack-roll",
          "mode": "disadvantage",
          "subject": "attacks-against-affected-creature",
          "when": {
            "attackerCanSeeAffectedCreature": false
          }
        }
      ]
    },
    {
      "id": "condition.paralyzed",
      "name": "Paralyzed",
      "kind": "condition",
      "description": "A Paralyzed creature is Incapacitated, immobile, and unable to speak. Attacks that hit from close range are automatically critical hits.",
      "appliesConditions": [
        "condition.incapacitated"
      ],
      "effects": [
        {
          "type": "speed",
          "operation": "set",
          "value": 0,
          "canIncrease": false
        },
        {
          "type": "speech",
          "availability": "none"
        },
        {
          "type": "saving-throw",
          "ability": "strength",
          "result": "automatic-failure"
        },
        {
          "type": "saving-throw",
          "ability": "dexterity",
          "result": "automatic-failure"
        },
        {
          "type": "roll-mode",
          "appliesTo": "attack-roll",
          "mode": "advantage",
          "subject": "attacks-against-affected-creature"
        },
        {
          "type": "critical-hit",
          "result": "automatic-critical-hit",
          "subject": "attacks-against-affected-creature",
          "when": {
            "attackerWithinFeet": 5,
            "attackHits": true
          },
          "countsAsNatural20": false
        }
      ]
    },
    {
      "id": "condition.petrified",
      "name": "Petrified",
      "kind": "condition",
      "description": "A Petrified creature becomes an inanimate substance but does not inherently lose awareness; an additional condition or effect can remove awareness.",
      "appliesConditions": [
        "condition.incapacitated"
      ],
      "effects": [
        {
          "type": "transformation",
          "into": "solid-inanimate-substance",
          "typicalMaterial": "stone",
          "includes": "nonmagical-worn-or-carried-objects"
        },
        {
          "type": "weight",
          "operation": "multiply",
          "factor": 10
        },
        {
          "type": "aging",
          "operation": "suspend"
        },
        {
          "type": "speed",
          "operation": "set",
          "value": 0,
          "canIncrease": false
        },
        {
          "type": "speech",
          "availability": "none"
        },
        {
          "type": "roll-mode",
          "appliesTo": "attack-roll",
          "mode": "advantage",
          "subject": "attacks-against-affected-creature"
        },
        {
          "type": "saving-throw",
          "ability": "strength",
          "result": "automatic-failure"
        },
        {
          "type": "saving-throw",
          "ability": "dexterity",
          "result": "automatic-failure"
        },
        {
          "type": "damage-resistance",
          "damageTypes": "all"
        },
        {
          "type": "immunity",
          "damageType": "poison"
        },
        {
          "type": "immunity",
          "condition": "condition.poisoned"
        },
        {
          "type": "immunity",
          "category": "disease"
        },
        {
          "type": "existing-affliction",
          "afflictions": [
            "poison",
            "disease"
          ],
          "operation": "suspend-not-neutralize",
          "resumeWhenConditionEnds": true
        }
      ]
    },
    {
      "id": "condition.poisoned",
      "name": "Poisoned",
      "kind": "condition",
      "effects": [
        {
          "type": "roll-mode",
          "appliesTo": "attack-roll",
          "mode": "disadvantage"
        },
        {
          "type": "roll-mode",
          "appliesTo": "ability-check",
          "mode": "disadvantage"
        }
      ]
    },
    {
      "id": "condition.prone",
      "name": "Prone",
      "kind": "condition",
      "description": "A Prone creature can crawl or spend movement to stand, has Disadvantage on attacks, and is easier to hit at close range.",
      "effects": [
        {
          "type": "movement-restriction",
          "allowed": [
            "crawl",
            "stand-up"
          ]
        },
        {
          "type": "roll-mode",
          "appliesTo": "attack-roll",
          "mode": "disadvantage",
          "subject": "attacks-by-affected-creature"
        },
        {
          "type": "roll-mode",
          "appliesTo": "attack-roll",
          "mode": "advantage",
          "subject": "attacks-against-affected-creature",
          "when": {
            "attackerWithinFeet": 5
          }
        },
        {
          "type": "roll-mode",
          "appliesTo": "attack-roll",
          "mode": "disadvantage",
          "subject": "attacks-against-affected-creature",
          "when": {
            "attackerBeyondFeet": 5
          }
        }
      ],
      "endsWhen": [
        {
          "event": "stands-up",
          "movementCost": {
            "operation": "half-speed",
            "round": "down"
          },
          "requiresPositiveSpeed": true
        }
      ]
    },
    {
      "id": "condition.restrained",
      "name": "Restrained",
      "kind": "condition",
      "effects": [
        {
          "type": "speed",
          "operation": "set",
          "value": 0,
