        },
        {
          "type": "roll-mode",
          "appliesTo": "saving-throw",
          "ability": "dexterity",
          "mode": "disadvantage"
        }
      ]
    },
    {
      "id": "condition.stunned",
      "name": "Stunned",
      "kind": "condition",
      "description": "A Stunned creature is Incapacitated, staggers at half Speed, and can speak only falteringly.",
      "appliesConditions": [
        "condition.incapacitated"
      ],
      "effects": [
        {
          "type": "speed",
          "operation": "multiply",
          "factor": 0.5
        },
        {
          "type": "speech",
          "availability": "faltering-only"
        },
        {
          "type": "saving-throw",
          "ability": "strength",
          "result": "automatic-failure"
        },
        {
          "type": "saving-throw",
          "ability": "dexterity",
          "result": "automatic-failure"
        },
        {
          "type": "roll-mode",
          "appliesTo": "attack-roll",
          "mode": "advantage",
          "subject": "attacks-against-affected-creature"
        }
      ]
    },
    {
      "id": "condition.unconscious",
      "name": "Unconscious",
      "kind": "condition",
      "description": "An Unconscious creature is unaware of its surroundings, unable to move or speak, and vulnerable to close-range critical hits.",
      "appliesConditions": [
        "condition.incapacitated",
        "condition.prone"
      ],
      "onApply": [
        {
          "event": "drop-held-objects"
        }
      ],
      "effects": [
        {
          "type": "speed",
          "operation": "set",
          "value": 0,
          "canIncrease": false
        },
        {
          "type": "speech",
          "availability": "none"
        },
        {
          "type": "awareness",
          "availability": "none"
        },
        {
          "type": "saving-throw",
          "ability": "strength",
          "result": "automatic-failure"
        },
        {
          "type": "saving-throw",
          "ability": "dexterity",
          "result": "automatic-failure"
        },
        {
          "type": "roll-mode",
          "appliesTo": "attack-roll",
          "mode": "advantage",
          "subject": "attacks-against-affected-creature"
        },
        {
          "type": "critical-hit",
          "result": "automatic-critical-hit",
          "subject": "attacks-against-affected-creature",
          "when": {
            "attackerWithinFeet": 5,
            "attackHits": true
          },
          "countsAsNatural20": false
        }
      ],
      "persistsAfterEnding": [
        "condition.prone"
      ]
    },
    {
      "id": "condition.wet",
      "name": "Wet",
      "kind": "condition",
      "description": "A wet creature is one that has recently been swimming or soaked in water, or who has been affected by an effect. Wet creatures have disadvantage on saving throws against spells and effects that deal cold or lightning damage, disadvantage on saving throws made to resist the effects of extreme cold, and advantage on saving throws against spells or effects that deal fire damage. A creature that takes 5 or more fire damage in a single instance, removes its wet clothing or armor (creatures with wet fur remain wet even if they do this), or that spends 1 hour around a source of heat loses this condition.",
      "appliedWhen": [
        {
          "event": "recently-swam"
        },
        {
          "event": "soaked-in-water"
        },
        {
          "event": "effect-applies-wet"
        }
      ],
      "effects": [
        {
          "type": "roll-mode",
          "appliesTo": "saving-throw",
          "mode": "disadvantage",
          "when": {
            "sourceKind": [
              "spell",
              "effect"
            ],
            "sourceDealsAnyDamageType": [
              "cold",
              "lightning"
            ]
          }
        },
        {
          "type": "roll-mode",
          "appliesTo": "saving-throw",
          "mode": "disadvantage",
          "when": {
            "purpose": "resist-extreme-cold"
          }
        },
        {
          "type": "roll-mode",
          "appliesTo": "saving-throw",
          "mode": "advantage",
          "when": {
            "sourceKind": [
              "spell",
              "effect"
            ],
            "sourceDealsDamageType": "fire"
          }
        }
      ],
      "endsWhen": [
        {
          "event": "takes-damage",
          "damageType": "fire",
          "minimumDamageTaken": 5,
          "sameDamageInstance": true
        },
        {
          "event": "removes-wet-clothing-or-armor",
          "unless": {
            "hasWetFur": true
          }
        },
        {
          "event": "remains-around-heat-source",
          "durationMinutes": 60
        }
      ]
    }
  ]
}
