          "availability": "none"
        },
        {
          "type": "check",
          "appliesTo": "ability-check",
          "requiresSense": "sight",
          "result": "automatic-failure"
        },
        {
          "type": "roll-mode",
          "appliesTo": "attack-roll",
          "mode": "disadvantage",
          "subject": "attacks-by-affected-creature"
        },
        {
          "type": "speed",
          "operation": "multiply",
          "factor": 0.5
        },
        {
          "type": "defense-adjustment",
          "operation": "suppress-contributions",
