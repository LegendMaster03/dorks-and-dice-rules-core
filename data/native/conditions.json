    {
      "id": "condition.cowering",
      "name": "Cowering",
      "kind": "condition",
      "description": "A Cowering creature is frozen by fear and cannot move, take an Action, Bonus Action, or Reaction. It loses applicable positive Dexterity and dodge contributions to AC and takes an additional -2 AC penalty. It does not automatically become Unconscious, Helpless, or lose Concentration.",
      "effects": [
        {
          "type": "action-restriction",
          "cannotTake": [
            "action",
            "bonus-action",
            "reaction"
          ]
        },
        {
          "type": "speed",
          "operation": "set",
          "value": 0,
          "canIncrease": false
        },
        {
          "type": "defense-adjustment",
          "operation": "suppress-contributions",
          "contributions": [
            "positive-dexterity",
            "dodge"
          ],
          "oncePerComponent": true
        },
        {
          "type": "defense-adjustment",
          "operation": "add-modifier",
          "defense": "armor-class",
          "value": -2
        }
      ]
    },
    {
