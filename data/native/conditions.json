    {
      "id": "condition.fascinated",
      "name": "Fascinated",
      "kind": "condition",
      "description": "A Fascinated creature devotes its attention to a compelling effect, remaining quiet and stationary. It cannot take actions other than attending to the effect, suffers -4 on reactive perception skill checks, and may resist a potential threat again. An obvious threat breaks the fascination; an ally may free it using an Action.",
      "effects": [
        {
          "type": "action-restriction",
          "cannotTake": [
            "action",
            "bonus-action",
            "reaction"
          ],
          "exceptions": [
            "pay-attention-to-fascinating-effect"
          ]
        },
        {
          "type": "movement-restriction",
          "restriction": "no-voluntary-movement",
          "exceptions": [
            "effect-expressly-allows"
          ]
        },
        {
          "type": "roll-modifier",
          "appliesTo": "skill-check",
          "skills": [
            "skill.listen",
            "skill.spot"
          ],
          "operation": "add",
          "value": -4,
          "when": {
            "purpose": "reaction-to-surroundings"
          },
          "appliesOnceToComposedCheck": true
        },
        {
          "type": "saving-throw-opportunity",
          "when": {
            "potentialThreatAppears": true
          },
          "against": "fascinating-effect",
          "resultOnSuccess": "condition-ends"
        }
      ],
      "endsWhen": [
        {
          "event": "obvious-threat-appears",
          "examples": [
            "weapon-drawn",
            "spell-cast",
            "ranged-weapon-aimed"
          ]
        },
        {
          "event": "ally-shakes-creature-free",
          "actionCost": "action"
        },
        {
          "event": "fascinating-effect-ends"
        }
      ]
    },
