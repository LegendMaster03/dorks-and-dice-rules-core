    {
      "id": "condition.flat-footed",
      "name": "Flat-Footed",
      "kind": "condition",
      "description": "A Flat-Footed creature cannot use applicable positive Dexterity or dodge bonuses to Armor Class and cannot make opportunity attacks. This is distinct from a temporary denial of the same AC contributions without the full condition.",
      "effects": [
        {
          "type": "defense-adjustment",
          "operation": "suppress-contributions",
          "contributions": [
            "positive-dexterity",
            "dodge"
          ],
          "oncePerComponent": true
        },
        {
          "type": "reaction-restriction",
          "prohibited": [
            "opportunity-attack"
          ],
          "doesNotProhibitOtherReactions": true
        }
      ]
    },
    {
      "id": "condition.frightened",
      "name": "Frightened",
