      "kind": "leveled-condition",
      "description": "Exhaustion measures cumulative weariness from environmental hazards, deprivation, special abilities, or other effects.",
      "levelRules": {
        "minimum": 0,
        "maximum": 6,
        "gain": "Increase the creature's exhaustion level by the number specified by the effect causing exhaustion.",
        "stacking": "A creature suffers the effects of its current exhaustion level and every lower level.",
        "endsAtLevel": 0
      },
      "levels": [
        {
          "level": 1,
          "effects": [
            {
              "type": "roll-mode",
              "appliesTo": "ability-check",
