    {
      "id": "condition.helpless",
      "name": "Helpless",
      "kind": "condition",
      "description": "A Helpless creature is unable to defend itself effectively. For Armor Class, treat its Dexterity score as 0 (modifier -5). Against melee attacks, apply a -4 AC exposure penalty equivalent to the one for Prone; if both conditions apply, use that penalty only once. Helpless alone does not determine awareness, speech, movement, or action economy.",
      "effects": [
        {
          "type": "defense-adjustment",
          "operation": "set-effective-ability-score",
          "ability": "dexterity",
          "value": 0,
          "modifier": -5,
          "defense": "armor-class",
          "supersedes": [
            "positive-dexterity",
            "dodge"
          ],
          "appliesTo": [
            "normal",
            "touch",
            "flat-footed",
            "touch-flat-footed"
          ]
        },
        {
          "type": "defense-adjustment",
          "operation": "add-modifier",
          "defense": "armor-class",
          "value": -4,
          "when": {
            "incomingAttackType": "melee"
          },
          "nonStackingGroup": "prone-or-helpless-melee-exposure"
        }
      ]
    },
    {
      "id": "condition.incapacitated",
      "name": "Incapacitated",
      "kind": "condition",
      "description": "An Incapacitated creature can not take actions, Bonus Actions, or Reactions. The condition does not itself restrict movement, speech, or awareness.",
      "effects": [
        {
          "type": "action-restriction",
          "cannotTake": [
            "action",
            "bonus-action",
            "reaction"
          ]
        },
        {
          "type": "concentration",
          "operation": "end"
        }
      ]
    },
    {
      "id": "condition.invisible",
      "name": "Invisible",
      "kind": "condition",
      "description": "An Invisible creature cannot be seen without magic or a special sense. Its location may still be detected by sound or tracks. Invisible attacks deny applicable Dexterity and dodge defenses to targets unable to see the attacker; this replaces the condition's previous attack Advantage rather than stacking with it. Attacks against the Invisible creature retain Disadvantage if the attacker cannot see it.",
      "effects": [
        {
          "type": "visibility",
          "availability": "invisible-to-ordinary-sight",
          "canBeSeenWith": [
            "magic",
            "special-sense"
          ],
          "includesWornOrCarriedEquipment": true
        },
        {
          "type": "obscuration",
          "degree": "heavily-obscured",
          "purpose": "hiding"
        },
        {
          "type": "location-clue",
          "detectableBy": [
            "sound",
            "tracks"
          ]
        },
        {
          "type": "targeting-protection",
          "appliesTo": "effects-requiring-target-to-be-seen",
          "unless": {
            "effectCreatorCanSeeAffectedCreature": true
          }
        },
        {
          "type": "roll-mode",
          "appliesTo": "attack-roll",
          "mode": "disadvantage",
          "subject": "attacks-against-affected-creature",
          "when": {
            "attackerCanSeeAffectedCreature": false
          }
        },
        {
          "type": "target-defense-adjustment",
          "target": "target-of-attacks-by-affected-creature",
          "operation": "suppress-contributions",
          "contributions": [
            "positive-dexterity",
            "dodge"
          ],
          "oncePerComponent": true,
          "when": {
            "targetCanSeeAffectedCreature": false
          }
        }
      ]
    },
    {
      "id": "condition.paralyzed",
      "name": "Paralyzed",
      "kind": "condition",
      "description": "A Paralyzed creature is Incapacitated and Helpless, immobile, and unable to speak. Attacks that hit from within 5 feet are automatic critical hits, but do not count as natural 20s.",
      "appliesConditions": [
        "condition.incapacitated",
        "condition.helpless"
      ],
      "effects": [
        {
          "type": "speed",
          "operation": "set",
          "value": 0,
          "canIncrease": false
        },
        {
          "type": "speech",
          "availability": "none"
        },
        {
          "type": "saving-throw",
          "ability": "strength",
          "result": "automatic-failure"
        },
        {
          "type": "saving-throw",
          "ability": "dexterity",
          "result": "automatic-failure"
        },
        {
          "type": "critical-hit",
          "result": "automatic-critical-hit",
          "subject": "attacks-against-affected-creature",
          "when": {
            "attackerWithinFeet": 5,
            "attackHits": true
          },
          "countsAsNatural20": false
        }
      ]
    },
