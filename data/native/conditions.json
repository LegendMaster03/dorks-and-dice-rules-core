    {
      "id": "condition.prone",
      "name": "Prone",
      "kind": "condition",
      "description": "A Prone creature can crawl or spend movement to stand. Its own attacks have Disadvantage. Its effective Armor Class is 4 lower against melee attacks and 4 higher against ranged attacks, reflecting the attack's type rather than the attacker's distance.",
      "effects": [
        {
          "type": "movement-restriction",
          "allowed": [
            "crawl",
            "stand-up"
          ]
        },
        {
          "type": "roll-mode",
          "appliesTo": "attack-roll",
          "mode": "disadvantage",
          "subject": "attacks-by-affected-creature"
        },
        {
          "type": "defense-adjustment",
          "operation": "add-modifier",
          "defense": "armor-class",
          "value": -4,
          "when": {
            "incomingAttackType": "melee"
          },
          "nonStackingGroup": "prone-or-helpless-melee-exposure"
        },
        {
          "type": "defense-adjustment",
          "operation": "add-modifier",
          "defense": "armor-class",
          "value": 4,
          "when": {
            "incomingAttackType": "ranged"
          }
        }
      ],
      "endsWhen": [
        {
          "event": "stands-up",
          "movementCost": {
            "operation": "half-speed",
            "round": "down"
          },
          "requiresPositiveSpeed": true
        }
      ]
