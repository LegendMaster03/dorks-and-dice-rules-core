{
  "_meta": {
    "status": "approved-native-5x-and-reviewed-3x-defense-consequences; execution-schema-not-yet-final",
    "note": "Eighteen canonical conditions, including Flat-Footed and Helpless. Native conditions use composable AC contributions rather than mutually exclusive stored AC numbers. Approved Exhaustion, Wet, Stunned half Speed and Petrified awareness are preserved. Original SRD 5.x source data remains in data/reference/srd/; 3.x provenance/decisions are in data/reference/3x/."
  },
  "conditions": [
    {
      "id": "condition.blinded",
      "name": "Blinded",
      "kind": "condition",
      "description": "A Blinded creature cannot see, moves at half Speed, and suffers impaired physical defenses. Attack rolls by the creature still have Disadvantage, without an additional blindness miss-chance roll.",
      "effects": [
        {
          "type": "sense",
          "sense": "sight",
          "availability": "none"
        },
        {
          "type": "check",
          "appliesTo": "ability-check",
          "requiresSense": "sight",
          "result": "automatic-failure"
        },
        {
          "type": "roll-mode",
          "appliesTo": "attack-roll",
          "mode": "disadvantage",
          "subject": "attacks-by-affected-creature"
        },
        {
          "type": "speed",
          "operation": "multiply",
          "factor": 0.5
        },
        {
          "type": "defense-adjustment",
          "operation": "suppress-contributions",
          "contributions": [
            "positive-dexterity",
            "dodge"
          ],
          "oncePerComponent": true
        },
        {
          "type": "defense-adjustment",
          "operation": "add-modifier",
          "defense": "armor-class",
          "value": -2
        }
      ]
    },
