                    "min": 43,
                    "max": 46
                  }
                },
                "Gnome, forest"
              ],
              [
                {
                  "type": "cell",
                  "roll": {
                    "min": 47,
                    "max": 52
                  }
                },
                "{@race Gnome|SRD51|Gnome, rock}"
              ],
              [
                {
                  "type": "cell",
                  "roll": {
                    "min": 53,
                    "max": 56
                  }
                },
                "{@race Half-Elf|SRD51}"
              ],
              [
                {
                  "type": "cell",
