                    "min": 57,
                    "max": 60
                  }
                },
                "{@race Half-Orc|SRD51}"
              ],
              [
                {
                  "type": "cell",
                  "roll": {
                    "min": 61,
                    "max": 68
                  }
                },
                "{@race Halfling|SRD51|Halfling, lightfoot}"
              ],
              [
                {
                  "type": "cell",
                  "roll": {
                    "min": 69,
                    "max": 76
                  }
                },
                "Halfling, stout"
              ],
              [
                {
                  "type": "cell",
                  "roll": {
                    "min": 77,
                    "max": 96
                  }
                },
                "{@race Human|SRD51}"
              ],
              [
                {
                  "type": "cell",
                  "roll": {
                    "min": 97,
                    "max": 0,
                    "pad": true
                  }
                },
                "{@race Tiefling|SRD51}"
              ]
            ]
          },
          "The reincarnated creature recalls its former life and experiences. It retains the capabilities it had in its original form, except it exchanges its original race for the new one and changes its racial traits accordingly."
        ],
        "affectsCreatureType": [
          "humanoid"
        ],
        "miscTags": [
          "HL",
