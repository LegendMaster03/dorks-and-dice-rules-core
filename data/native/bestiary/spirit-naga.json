                  "{@spell dominate person}"
                ]
              }
            },
            "ability": "int"
          }
        ],
        "trait": [
          {
            "name": "Rejuvenation",
            "entries": [
              "If it dies, the naga returns to life in {@dice 1d6} days and regains all its hit points. Only a {@spell wish} spell can prevent this trait from functioning."
            ]
