            ]
          },
          {
            "name": "Bite",
            "entries": [
              "{@atk mw} {@hit 8} to hit, reach 5 ft., one target. {@h}21 ({@damage 3d10 + 5}) piercing damage, and the target is {@condition grappled} (escape {@dc 16}). Until this grapple ends, the target is {@condition restrained}, and the crocodile can't bite another target."
            ]
          },
          {
            "name": "Tail",
            "entries": [
              "{@atk mw} {@hit 8} to hit, reach 10 ft., one target not {@condition grappled} by the crocodile. {@h}14 ({@damage 2d8 + 5}) bludgeoning damage. If the target is a creature, it must succeed on a {@dc 16} Strength saving throw or be knocked {@condition prone}."
            ]
          }
