                "slots": 4,
                "spells": [
                  "{@spell command}",
                  "{@spell cure wounds}",
                  "{@spell shield of faith}"
                ]
              },
              "2": {
                "slots": 3,
                "spells": [
                  "{@spell calm emotions}",
                  "{@spell hold person}"
                ]
              },
              "3": {
                "slots": 3,
