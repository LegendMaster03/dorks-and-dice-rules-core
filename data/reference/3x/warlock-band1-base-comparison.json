  ],
  "decisions": [
    {
      "id": "invocation-selection-progression",
      "status": "owner-decision-needed",
      "subject": "Native invocation choices at each class level",
      "sourceDifferences": "3.5 1→12 known; 2014 0→8; 2024 1→10",
      "recommendation": "Use one native selection track; do not add the counts or reconcile individual options in Band 1",
      "minimumImplementation": "Define selection events, eligibility and replacement rules; reference shared later-reconciled catalog"
    },
    {
      "id": "eldritch-blast",
      "status": "owner-decision-needed",
      "subject": "Automatic blast access, attack method and scaling",
      "sourceDifferences": "3.5 automatically grants a spell-like invocation (1–9d6; ranged touch); 5.x Eldritch Blast is selectable cantrip scaling by total character level and beams",
      "recommendation": "Choose one native attack/damage progression; do not add 3.5 dice to modern beams",
      "minimumImplementation": "Baseline entitlement and scaling; option-specific shapes and essences deferred"
    },
    {
      "id": "pact-boons",
      "status": "owner-decision-needed",
      "subject": "Choice classification and grant timing",
      "sourceDifferences": "2014 one independent Pact Boon choice at class level 3; 2024 Blade/Chain/Tome included in invocation choice catalog from class level 1",
      "recommendation": "Select either independent class-granted boon or invocation-path boon; do not grant both automatically",
      "minimumImplementation": "Define timing, count, prerequisites, replacement policy, option details deferred"
    },
    {
      "id": "historical-defense-utility",
      "status": "approved-native-rule",
      "subject": "Whether to retain additive distinct 3.5 class features",
      "sourceDifferences": "3.5 Detect Magic at 2, damage reduction 3/7/11/15/19, Deceive Item 4, Fiendish Resilience 8/13/18, Energy Resistance 10/20, Imbue Item 12; not matched by modern base features",
      "recommendation": "Approved: retain four Warlock universal base-class feature families; fast healing now appears only as one of TWO Fiend-specific Infernal Retaliation effects (with Flamewreath), one use per Long Rest; 8/13/18 progression; stabilization once without recovery of consciousness at 0 HP. Hellfire Shield is separate optional Hellfire specialization; automatic Detect Magic excluded.",
      "minimumImplementation": "Grant only four retained base-class families. For the Fiend Patron, implement one Infernal Retaliation feature at Warlock level 8, upgrading 13 and 18, with TWO effects using one shared Long Rest use; active fast healing stabilizes once at 0 HP but does not heal or restore consciousness there. Hellfire Shield is a separate optional Hellfire specialization candidate requiring its own design.",
      "approvedDisposition": {
        "retainedClassFeatureFamilies": [
          "damage-reduction",
          "deceive-item",
          "energy-resistance",
          "imbue-item"
        ],
        "detectMagic": "not-automatic; retained through optional Eldritch Sight invocation selection",
        "damageReduction": [
          {
            "classLevel": 3,
            "value": 1
          },
          {
            "classLevel": 7,
            "value": 2
          },
          {
            "classLevel": 11,
            "value": 3
          },
          {
            "classLevel": 15,
            "value": 4
          },
          {
            "classLevel": 19,
            "value": 5
          }
        ],
        "damageReductionException": "cold-iron",
        "damageReductionMechanic": "native-flat-damage-reduction-not-half-damage-resistance",
        "deceiveItem": {
          "classLevel": 4,
          "benefit": "historical-take-10-when-distracted-or-threatened",
          "check": "native-shared-magical-item-competency",
          "doesNotWaiveRequirements": true
        },
        "energyResistance": {
          "classLevels": [
            10,
            20
          ],
          "choices": 2,
          "sourceTypes": [
            "acid",
            "cold",
            "electricity",
            "fire",
            "sonic"
          ],
          "nativeTypeMappings": {
            "electricity": "lightning",
            "sonic": "thunder"
          },
          "values": [
            5,
            10
          ],
          "mechanic": "fixed-damage-mitigation-not-half-damage-resistance"
        },
        "imbueItem": {
          "classLevel": 12,
          "requiresAppropriateItemCreationEntitlement": true,
          "substitutesMissingSpellPrerequisiteThroughSharedMagicalItemCheck": true,
          "sourceDcs": {
            "arcane": "15 + spell level",
            "divine": "25 + spell level"
          },
          "failedCheck": "crafting stopped with creation costs unspent; cannot reattempt missing spell substitution until new Warlock level",
          "implementation": "use-shared-item-creation-and-competency-systems"
        },
        "notApproved": [
          "individual-eldritch-invocation-reconciliation",
          "other-warlock-base-class-decisions",
          "patron-subclasses"
        ],
        "fiendPatronInfernalRetaliation": {
          "featureId": "warlock.patron.fiend.infernal-retaliation",
          "scope": "Fiend Patron only",
          "singleFeatureEntitlement": true,
          "effects": [
            "fiendish-resilience-fast-healing",
            "fiendish-flamewreath"
          ],
          "sharedUses": 1,
          "recovery": "long-rest",
          "needsNativeAcquisitionAndEffectDetails": false,
          "grantClassLevel": 8,
          "upgradeClassLevels": [
            13,
            18
          ],
          "fastHealingAtZeroHp": "stabilize-once-remain-unconscious-no-healing-or-repeat-stabilization",
          "effectDurationRounds": 20,
          "needsNativeEffectResolutionAndImplementation": true
        },
        "hellfireShieldNativeDisposition": "Removed from Infernal Retaliation; optional Hellfire specialization candidate with independent acquisition and resource to be decided during Invocations."
      },
      "priorApprovedBaseHealing": {
        "sourceFeature": "fiendish-resilience",
        "historicalCandidateValues": {
          "classLevels": [
            8,
            13,
            18
          ],
          "healingPerRound": [
            1,
            2,
            5
          ],
          "durationRounds": 20,
          "uses": 1,
          "recharge": "long-rest",
          "activationTiming": "shared-action-rules"
        },
        "originalClassification": "3.5e universal base Warlock",
        "status": "superseded-as-native-base-class-grant"
      }
    },
    {
      "id": "invocation-grade-gating",
      "status": "follow-on-to-invocation-progression",
      "subject": "Legacy grades least/lesser/greater/dark",
      "sourceDifferences": "3.5 levels 1/6/11/16; modern 5.x option-specific prerequisites",
      "recommendation": "Track historical grade eligibility as source data; if merged into one pool use underlying prerequisites rather than a second gated selection list",
      "minimumImplementation": "Store grade unlock metadata and implement applicability in shared option catalog later"
    },
    {
      "id": "recovery-capstone",
      "status": "source-equivalence-check",
      "subject": "Eldritch Master and Magical Cunning",
      "sourceDifferences": "2014 level-20 1-minute restore all Pact slots once per Long Rest; 2024 level-2 1-minute restore up to half once per Long Rest, upgrading to all at level 20",
      "recommendation": "Retain 2024 single progressive feature without awarding a duplicated additional full recharge unless separately approved",
      "minimumImplementation": "Magical Cunning at 2 and level-20 Eldritch Master upgrade to full recovery"
    },
    {
      "id": "subclass-milestones",
      "status": "shared-class-rule-already-established",
      "subject": "Patron subclass grant timing",
      "sourceDifferences": "2014 patron feature starting level 1; 2024 patron subclass first level 3",
      "recommendation": "Use modern subclass milestone levels 3/6/10/14; actual subclass powers deferred",
      "minimumImplementation": "Only create subclass milestones, not patron subclass effects"
    },
    {
      "id": "spells-and-rest-resources",
      "status": "shared-casting-constraints-already-established",
      "subject": "Pact Magic distinctness and no daily preparation",
      "sourceDifferences": "3.5 Warlock has spell-like invocations, no Pact slots; 2014 and 2024 use Pact slots with Short Rest recharge and Mystic Arcanum 11/13/15/17",
      "recommendation": "Keep Pact Magic distinct from ordinary full caster and Warlock spell list finite-known without preparation; do not derive unapproved spell-point conversion",
      "minimumImplementation": "Reconcile source Pact slot progression, spells known and Mystic Arcanum levels"
    },
    {
      "id": "level19-feat",
      "status": "shared-epic-boon-rule-already-established",
      "subject": "2024 Epic Boon versus level 19 ASI",
      "sourceDifferences": "2014 ASI/eligible feat at class level 19; 2024 Epic Boon feat at 19",
      "recommendation": "ASI or other eligible feat at level 19; Epic Boons only total character level 21+",
      "minimumImplementation": "Use existing normal level-19 feat eligibility"
    }
  ],
