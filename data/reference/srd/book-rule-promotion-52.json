  "corrections": [
    {
      "id": "rule.multiclassing",
      "reason": "Remove non-SRD Eldritch Knight/Arcane Trickster spell-slot contributions; retain legacy half-caster rounding down and modern rounding up as printed. Normalize book navigation; canonicalize nested tables."
    },
    {
      "id": "rule.combat-encounters",
      "reason": "Restore Giant Rat and Druid encounter examples and remove the commercial Monster Manual navigation from pp.202–203."
    },
    {
      "id": "rule.magic-item-rarity",
      "reason": "Restore the published generic planar city example and +1 plate armor display label from pp.205–206."
    },
    {
      "id": "rule.rhythm-of-play",
      "reason": "Restore published introductory wording and Game Master label (p.5)."
    },
    {
      "id": "rule.the-six-abilities",
      "reason": "Retain publisher ability score and round-down guidance with existing tables (pp.5–6)."
    },
    {
      "id": "rule.d20-tests",
      "reason": "Use publisher GM terminology and edition-local navigation; link the existing resolution seed and glossary (pp.6–8)."
    },
    {
      "id": "rule.proficiency",
      "reason": "Reconcile all 18 canonical skill table rows and retain tool/skill Advantage rule (pp.8–9)."
    },
    {
      "id": "rule.actions",
      "reason": "Preserve original action economy and link all twelve existing actions (pp.9–10)."
    },
    {
      "id": "rule.social-interaction",
      "reason": "Restore publisher punctuation and GM navigation (pp.10–11)."
    },
    {
      "id": "rule.exploration",
      "reason": "Restore published Equipment and Gameplay Toolbox navigation and local hazard/sense identities (pp.11–12)."
    },
    {
      "id": "rule.combat",
      "reason": "Preserve modern surprise, occupied-space, grid, mounting and underwater rules with edition-local references (pp.13–16)."
    },
    {
      "id": "rule.damage-and-healing",
      "reason": "Restore publisher opening and local damage, knockout, rest and stabilization references (pp.16–18)."
    },
    {
      "id": "rule.choose-a-character-sheet",
      "reason": "Preserve publisher sheet selection guidance (p.19)."
    },
    {
      "id": "rule.create-your-character",
      "reason": "Restore publisher character creation instructions and formulas, omit source-only sample-sheet and free-trinket guidance, link existing species/backgrounds and tables (pp.19–23)."
    },
    {
      "id": "rule.level-advancement",
      "reason": "Preserve minimum 1 HP, level progression and post-level-20 bonus feat guidance (pp.23–24)."
    },
    {
      "id": "rule.starting-at-higher-levels",
      "reason": "Restore publisher terminology and reuse starting-equipment table (p.24)."
    },
    {
      "id": "rule.mounts-and-vehicles",
      "reason": "Restore Monsters navigation and preserve ship crew, cargo, repair and damage threshold guidance (pp.100–101)."
    },
    {
      "id": "rule.magic-items",
      "reason": "Reuse the existing canonical identification, attunement and wearing rules instead of duplicating them (pp.102–103)."
    },
    {
      "id": "rule.gaining-spells",
      "reason": "Preserve class preparation and always-prepared spell rules (p.104)."
    },
    {
      "id": "rule.casting-spells",
      "reason": "Restore explicit spell DC/attack formulas, retain one-slot-per-turn and invalid-target rules; link edition-local spell and glossary identities (pp.104–106)."
    },
    {
      "id": "rule.curses-and-magical-contagions",
      "reason": "Restore publisher curse introduction and link canonical contagions and spells (pp.193–194)."
    },
    {
      "id": "rule.environmental-effects",
      "reason": "Index nine existing environmental effects rather than duplicating their descriptions (p.195)."
    },
    {
      "id": "rule.fear-and-mental-stress",
      "reason": "Preserve publisher discretionary effects and use the canonical example tables (p.196)."
    },
    {
      "id": "rule.poison",
      "reason": "Restore the publisher Crawler Mucus and Spider's Sting names and reference the fourteen existing poisons (pp.197–198)."
    },
    {
      "id": "rule.traps",
      "reason": "Link all eight canonical trap definitions and retain publisher severity, trigger and duration guidance (pp.199–201)."
    },
    {
      "id": "rule.stat-block-overview",
      "reason": "Remove source-only Vampire Familiar example and numbering; retain all eight publisher stat-block categories (p.254)."
    },
    {
      "id": "rule.parts-of-a-stat-block",
      "reason": "Restore published creature-type examples and preserve monster stat-block guidance and tables (pp.254–257)."
    }
