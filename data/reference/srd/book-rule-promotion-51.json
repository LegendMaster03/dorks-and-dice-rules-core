  "corrections": [
    {
      "id": "table.adventuring-gear",
      "reason": "Restore published p.69 gear ordering and labels; move climber's and mess kits, remove duplicate healer's kit and four tool-only kit rows; retain their canonical definitions and Tools table memberships.",
      "pages": [
        69
      ]
    },
    {
      "id": "table.tools",
      "reason": "Exclude two gaming-set rows absent from the official Tools table; restore singular headings and remove stray punctuation in cartographer's tools price. Retain the publisher's vehicle-proficiency footnote.",
      "pages": [
        70
      ]
    },
    {
      "id": "table.tack-harness-and-drawn-vehicles",
      "reason": "Use published Feed (per day) label and link the existing item; Barding is an armor price/weight multiplier, not a standalone equipment identity.",
      "pages": [
        71,
        72
      ]
    },
    {
      "id": "rule.multiclassing",
      "reason": "Remove non-SRD Eldritch Knight/Arcane Trickster spell-slot contributions; retain legacy half-caster rounding down and modern rounding up as printed. Normalize book navigation; canonicalize nested tables."
    },
    {
      "id": "rule.advantage-and-disadvantage",
      "reason": "Restore the original reroll-only wording and unrestricted Inspiration wording from pp.76–77; remove later source additions."
    },
    {
      "id": "rule.resting",
      "reason": "Restore published short-rest healing wording and long-rest sleep/light-activity wording from p.87; do not import later errata into the pinned SRD."
    },
    {
      "id": "rule.attunement",
      "reason": "Restore explicit class membership prerequisite from p.206 and the publisher's spellcasting-class monster exception."
    },
    {
      "id": "rule.wearing-and-wielding-items",
      "reason": "Restore published size/anatomy and paired-item wording on p.206."
    },
    {
      "id": "rule.activating-an-item",
      "reason": "Restore publisher pp.206–207 activation, consumable, command-word, spell-level and charge wording; retain the published Use an Item label with the local Use an Object action reference."
    },
    {
      "id": "rule.movement",
      "reason": "Restore published forced-march navigation and high-jump formula without later minimum-0 errata; remove absent commercial navigation (pp.84–85)."
    },
    {
      "id": "rule.between-adventures",
      "reason": "Correct source punctuation and GM terminology to publisher pp.88–89."
    },
    {
      "id": "rule.what-is-a-spell",
      "reason": "Restore Wish example, bard/sorcerer examples, Warlock spell-slot exception and appendix label on p.100."
    },
    {
      "id": "rule.ability-checks",
      "reason": "Reconcile the grouped skill list with all 18 canonical skill definitions; restore published variant example and navigation; preserve passive formula as text (pp.77–79)."
    },
    {
      "id": "rule.the-environment",
      "reason": "Remove absent commercial navigation, restore appendix labels and correct object-interaction transcription (pp.86–87)."
    },
    {
      "id": "rule.the-order-of-combat",
      "reason": "Restore publisher GM terminology and remove later chapter navigation (pp.90–91)."
    },
    {
      "id": "rule.movement-and-position",
      "reason": "Restore publisher five Large creatures example and appendix/navigation wording (pp.91–92)."
    },
    {
      "id": "rule.making-an-attack",
      "reason": "Use existing canonical attack options, corrected against pp.95–96, instead of duplicating their procedures; restore publisher attack navigation."
    },
    {
      "id": "rule.damage-and-healing",
      "reason": "Restore the published nonnegative damage floor and appendix label; link canonical stabilization procedure (pp.96–99)."
    },
    {
      "id": "rule.casting-a-spell",
      "reason": "Restore school introduction and publisher navigation; remove later equal-potency recency rule (pp.101–104)."
    },
    {
      "id": "rule.using-each-ability",
      "reason": "Reuse all 18 canonical skill descriptions after exact normalized body checks; restore publisher environmental navigation (pp.79–83)."
    },
    {
      "id": "rule.alignment",
      "reason": "Restore publisher-specific fictional multiverse alignment paragraphs and remove later source rewrites (pp.58–59)."
    },
    {
      "id": "rule.languages",
      "reason": "Restore publisher standard-language selection rule (p.59)."
    },
    {
      "id": "rule.inspiration",
      "reason": "Restore publisher GM terminology (pp.59–60)."
    },
    {
      "id": "rule.backgrounds",
      "reason": "Restore publisher introduction and navigation; reference the existing Acolyte definition (p.60)."
    }
  ],
