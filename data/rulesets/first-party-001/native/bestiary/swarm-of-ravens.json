        "name": "Swarm",
        "entries": [
          "The swarm can occupy another creature's space and vice versa, and the swarm can move through any opening large enough for a Tiny raven. The swarm can't regain {@variantrule Hit Points|SRD52} or gain {@variantrule Temporary Hit Points|SRD52}."
        ]
      }
    ],
    "action": [
      {
        "name": "Beaks",
        "entries": [
          "{@atkr m} {@hit 4}, reach 5 ft. {@h}5 ({@damage 1d6 + 2}) Piercing damage, or 2 ({@damage 1d4}) Piercing damage if the swarm is {@status Bloodied|SRD52}."
        ]
      },
      {
        "name": "Cacophony {@recharge}",
        "entries": [
          "{@actSave wis} {@dc 10}, one creature in the swarm's space. {@actSaveFail} The target has the {@condition Deafened|SRD52} condition until the start of the swarm's next turn. While {@condition Deafened|SRD52}, the target also has {@variantrule Disadvantage|SRD52} on ability checks and attack rolls."
        ]
